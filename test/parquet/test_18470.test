# name: test/parquet/test_18470.test
# description: Test issue #18470 - Internal Error when querying multiple Parquet files that have mixed data type for same column
# group: [parquet]

require parquet

require notwindows

statement ok
COPY (
    SELECT
        generate_series::UINT16 as column1,
        'text_value_' || row_number() OVER () as column2
    FROM generate_series(1, 100)
) TO '{TEST_DIR}/20250101.parquet' (FORMAT PARQUET);

statement ok
COPY (
    SELECT
        (generate_series + 100)::UINT64 as column1,
        'text_value_' || row_number() OVER () as column2
    FROM generate_series(1, 100)
) TO '{TEST_DIR}/20250102.parquet' (FORMAT PARQUET);

query III
SELECT filename = '{TEST_DIR}/20250101.parquet', *
FROM read_parquet('{TEST_DIR}/2025010*.parquet')
WHERE filename >= '{TEST_DIR}/20250101.parquet'
AND column1 = 72
LIMIT 10;
----
true	72	text_value_72
