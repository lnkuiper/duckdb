# name: test/sql/table_function/parallel_generated_random.test
# description: Dense generated projections preserve the serial seeded random streams
# group: [table_function]

require skip_reload

statement ok
PRAGMA verify_parallelism

statement ok
CREATE TABLE generated(i BIGINT, a DOUBLE, b DOUBLE)

statement ok
PREPARE populate AS INSERT INTO generated SELECT i, random(), random() FROM range(4097) t(i)

statement ok
PREPARE populate_chain AS INSERT INTO generated SELECT i, a, random() FROM (SELECT i, random() a FROM generate_series(0, 4096) t(i))

# This digest comes from the serial range implementation. The prepared
# statement must obtain fresh expression seeds at execution, independent of workers.
foreach population populate populate_chain

foreach threads 1 4 8

statement ok
SET threads={threads}

statement ok
DELETE FROM generated

statement ok
SELECT setseed(0.42)

statement ok
EXECUTE {population}

query IT
SELECT count(*), md5(string_agg(i || ':' || a || ':' || b, ',' ORDER BY i)) FROM generated
----
4097	8a14d72555e3d30b68edb8b52ed0c48f

# Local worker initialization must not consume additional client RNG seeds.
query TT
SELECT random()::VARCHAR, random()::VARCHAR
----
0.18256470778688086	0.7935885720545943

endloop

endloop

statement ok
PRAGMA disable_verify_parallelism
