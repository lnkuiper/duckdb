# name: test/sql/table_function/parallel_generated_random.test
# description: Dense generated projections reproduce seeded data independently of worker scheduling
# group: [table_function]

require skip_reload

statement ok
PRAGMA verify_parallelism

statement ok
CREATE TABLE generated(i BIGINT, a DOUBLE, b DOUBLE)

statement ok
CREATE TABLE expected(i BIGINT, a DOUBLE, b DOUBLE)

statement ok
PREPARE populate AS INSERT INTO generated SELECT i, random(), random() FROM range(4097) t(i)

statement ok
PREPARE populate_chain AS INSERT INTO generated SELECT i, a, random() FROM (SELECT i, random() a FROM generate_series(0, 4096) t(i))

# Compare each query with its own single-threaded baseline. Prepared execution
# obtains fresh expression seeds, independently of the worker count.
foreach population populate populate_chain

statement ok
SET threads=1

statement ok
DELETE FROM generated

statement ok
DELETE FROM expected

statement ok
SELECT setseed(0.42)

statement ok
EXECUTE {population}

statement ok
INSERT INTO expected SELECT * FROM generated

foreach threads 1 4 8

statement ok
SET threads={threads}

statement ok
DELETE FROM generated

statement ok
SELECT setseed(0.42)

statement ok
EXECUTE {population}

query III
SELECT count(*), count(*) FILTER (WHERE a = b), count(*) FILTER (WHERE a < 0 OR a >= 1 OR b < 0 OR b >= 1) FROM generated
----
4097	0	0

query I
SELECT count(*) FROM ((TABLE generated EXCEPT ALL TABLE expected) UNION ALL (TABLE expected EXCEPT ALL TABLE generated))
----
0

endloop

# Changing the seed must change the prepared statement's data.
statement ok
DELETE FROM generated

statement ok
SELECT setseed(-0.25)

statement ok
EXECUTE {population}

query I
SELECT count(*) > 0 FROM generated JOIN expected USING (i) WHERE generated.a <> expected.a
----
true

endloop

statement ok
PRAGMA disable_verify_parallelism
