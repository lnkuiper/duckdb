# name: test/sql/table_function/parallel_generated_random.test
# description: Generated projections reproduce seeded data through ordinary ordinal arguments
# group: [table_function]

require skip_reload

statement ok
PRAGMA verify_parallelism

statement ok
CREATE TABLE generated(i BIGINT, a DOUBLE, b DOUBLE)

statement ok
CREATE TABLE expected(i BIGINT, a DOUBLE, b DOUBLE)

statement ok
PREPARE populate AS INSERT INTO generated SELECT i, random(), random() FROM range(4097) t(i)

statement ok
PREPARE populate_chain AS INSERT INTO generated SELECT i, a, random() FROM (SELECT i, random() a FROM generate_series(0, 4096) t(i))

# An unrelated CASE must not disable positional random state.
statement ok
PREPARE populate_case_sibling AS INSERT INTO generated
SELECT CASE WHEN i % 2 = 0 THEN i ELSE -i END, random(), random() FROM range(4097) t(i)

# The first chunk skips the first random expression through constant NULL handling.
statement ok
PREPARE populate_skipped_argument AS INSERT INTO generated
SELECT i, (CASE WHEN i < 2048 THEN NULL::DOUBLE ELSE 0.5 END) * random(), random() FROM range(4097) t(i)

statement ok
PREPARE populate_selected_case AS INSERT INTO generated
SELECT i, CASE WHEN i%3=0 THEN random() WHEN i%2=0 THEN random() END, random() FROM range(4097) t(i)

statement ok
PREPARE populate_coalesce AS INSERT INTO generated
SELECT i, COALESCE(CASE WHEN i%2=0 THEN 0.5 END, random()), random() FROM range(4097) t(i)

statement ok
PREPARE populate_conjunction AS INSERT INTO generated
SELECT i, CASE WHEN i%2=0 AND random()<0.5 THEN random() END, random() FROM range(4097) t(i)

statement ok
PREPARE populate_lambda_argument AS INSERT INTO generated
SELECT i, list_transform([random()], lambda x: x)[1], random() FROM range(4097) t(i)

statement ok
PREPARE populate_uuid AS INSERT INTO generated
SELECT i, CASE WHEN uuid_extract_version(uuid()) = 4 THEN random() END, random() FROM range(4097) t(i)

statement ok
CREATE TABLE source AS SELECT i FROM range(4097) t(i)

statement ok
PREPARE populate_table AS INSERT INTO generated SELECT i, random(), random() FROM source

statement ok
PREPARE populate_filtered AS INSERT INTO generated
SELECT i, random(), random() FROM range(-4097, 4097) t(i) WHERE i >= 0

statement ok
PREPARE populate_repeat AS INSERT INTO generated
SELECT column0, random(), random() FROM repeat_row(42, 'unused', num_rows=4097)

statement ok
PREPARE populate_unused_ordinality AS INSERT INTO generated
SELECT i, random(), random() FROM range(4097) WITH ORDINALITY t(i, n)

# Compare two consecutive queries after one setseed with a single-threaded baseline.
# Worker-local consumers such as UUID must not affect the next query's random seed.
foreach population populate populate_chain populate_case_sibling populate_skipped_argument populate_selected_case populate_coalesce populate_conjunction populate_lambda_argument populate_uuid populate_table populate_filtered populate_repeat populate_unused_ordinality

statement ok
SET threads=1

statement ok
DELETE FROM generated

statement ok
DELETE FROM expected

statement ok
SELECT setseed(0.42)

statement ok
EXECUTE {population}

statement ok
EXECUTE {population}

statement ok
INSERT INTO expected SELECT * FROM generated

foreach threads 1 4 8

statement ok
SET threads={threads}

statement ok
DELETE FROM generated

statement ok
SELECT setseed(0.42)

statement ok
EXECUTE {population}

statement ok
EXECUTE {population}

query III
SELECT count(*), count(*) FILTER (WHERE a = b), count(*) FILTER (WHERE a < 0 OR a >= 1 OR b < 0 OR b >= 1) FROM generated
----
8194	0	0

query I
SELECT count(*) FROM ((TABLE generated EXCEPT ALL TABLE expected) UNION ALL (TABLE expected EXCEPT ALL TABLE generated))
----
0

endloop

# Changing the seed must change the prepared statement's data.
statement ok
DELETE FROM generated

statement ok
SELECT setseed(-0.25)

statement ok
EXECUTE {population}

statement ok
EXECUTE {population}

query I
SELECT count(*) > 0 FROM (TABLE generated EXCEPT ALL TABLE expected)
----
true

endloop

# Without reseeding, successive executions must generate different data.
statement ok
DELETE FROM generated

statement ok
EXECUTE populate

statement ok
CREATE TABLE previous_generation AS FROM generated

statement ok
DELETE FROM generated

statement ok
EXECUTE populate

query I
SELECT count(*) > 0 FROM (TABLE generated EXCEPT ALL TABLE previous_generation)
----
true

statement error
SELECT random(1)
----
No function matches

statement ok
PRAGMA disable_verify_parallelism

# Selected random evaluation emits one value for each selected row.
query I
SELECT count(r) FROM (SELECT CASE WHEN i % 2 = 0 THEN random() END r FROM range(4097) t(i))
----
2049
